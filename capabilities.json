{
    "dataRoles": [
        {
            "displayName": "Date (?)",
            "description": "Required. A date or date/time column — one row per day. Each day becomes a cell in the calendar grid.",
            "name": "date",
            "kind": "Grouping"
        },
        {
            "displayName": "Value (?)",
            "description": "Required. A numeric measure or column shown for each day; its magnitude sets the cell's color intensity. Multiple values on the same day are combined using the Aggregate setting (Sum, Average, Min, Max or Count).",
            "name": "value",
            "kind": "Measure"
        },
        {
            "displayName": "Split by (?)",
            "description": "Optional. A category column (e.g. Region, Product, Team). When bound, the visual renders one small-multiple calendar per category value, all sharing the same date axis and — by default — the same color scale for easy comparison.",
            "name": "category",
            "kind": "Grouping"
        },
        {
            "displayName": "Target (?)",
            "description": "Optional. A numeric goal or benchmark for each day. The tooltip shows the day's value against this target (over / under, and the % variance). Combined per day using the same Aggregate setting as Value.",
            "name": "target",
            "kind": "Measure"
        },
        {
            "displayName": "Annotations (?)",
            "description": "Optional. A text column marking notable days — holidays, releases, incidents, campaigns. Flagged days get a small marker on the grid and the note in their hover tooltip.",
            "name": "annotation",
            "kind": "Grouping"
        },
        {
            "displayName": "Tooltips (?)",
            "description": "Optional. One or more extra measures or fields to show in each cell's hover tooltip, alongside the date and value.",
            "name": "tooltips",
            "kind": "Measure"
        }
    ],
    "dataViewMappings": [
        {
            "conditions": [
                { "date": { "max": 1 }, "value": { "max": 1 }, "target": { "max": 1 }, "annotation": { "max": 1 }, "category": { "max": 1 } }
            ],
            "categorical": {
                "categories": {
                    "select": [
                        { "for": { "in": "date" } },
                        { "bind": { "to": "annotation" } },
                        { "bind": { "to": "category" } }
                    ],
                    "dataReductionAlgorithm": { "window": { "count": 30000 } }
                },
                "values": {
                    "select": [
                        { "bind": { "to": "value" } },
                        { "bind": { "to": "target" } },
                        { "for": { "in": "tooltips" } }
                    ]
                }
            }
        }
    ],
    "objects": {
        "dataDisplay": {
            "properties": {
                "layout": { "type": { "enumeration": [ { "value": "continuous", "displayName": "Continuous" }, { "value": "month", "displayName": "Month blocks" } ] } },
                "firstDayOfWeek": { "type": { "enumeration": [ { "value": "0", "displayName": "Sunday" }, { "value": "1", "displayName": "Monday" } ] } },
                "aggregation": { "type": { "enumeration": [ { "value": "sum", "displayName": "Sum" }, { "value": "avg", "displayName": "Average" }, { "value": "min", "displayName": "Min" }, { "value": "max", "displayName": "Max" }, { "value": "count", "displayName": "Count" } ] } }
            }
        },
        "timeIntel": {
            "properties": {
                "fiscalStart": { "type": { "enumeration": [ { "value": "1", "displayName": "January" }, { "value": "2", "displayName": "February" }, { "value": "3", "displayName": "March" }, { "value": "4", "displayName": "April" }, { "value": "5", "displayName": "May" }, { "value": "6", "displayName": "June" }, { "value": "7", "displayName": "July" }, { "value": "8", "displayName": "August" }, { "value": "9", "displayName": "September" }, { "value": "10", "displayName": "October" }, { "value": "11", "displayName": "November" }, { "value": "12", "displayName": "December" } ] } }
            }
        },
        "smallMultiples": {
            "properties": {
                "columns": { "type": { "numeric": true } },
                "sharedScale": { "type": { "bool": true } }
            }
        },
        "cells": {
            "properties": {
                "cellSize": { "type": { "numeric": true } },
                "cellGap": { "type": { "numeric": true } },
                "cornerRadius": { "type": { "numeric": true } }
            }
        },
        "labels": {
            "properties": {
                "showMonthLabels": { "type": { "bool": true } },
                "showWeekdayLabels": { "type": { "bool": true } },
                "showHeader": { "type": { "bool": true } }
            }
        },
        "colors": {
            "properties": {
                "paletteMode": { "type": { "enumeration": [ { "value": "mono", "displayName": "Mono" }, { "value": "ramp", "displayName": "Ramp" }, { "value": "duotone", "displayName": "Duotone" }, { "value": "split", "displayName": "Split" }, { "value": "theme", "displayName": "Report theme" } ] } },
                "ramp": { "type": { "enumeration": [ { "value": "violet", "displayName": "Violet" }, { "value": "ocean", "displayName": "Ocean" }, { "value": "forest", "displayName": "Forest" }, { "value": "magma", "displayName": "Magma" }, { "value": "viridis", "displayName": "Viridis" }, { "value": "colorblind", "displayName": "Colorblind-safe" } ] } },
                "startColor": { "type": { "fill": { "solid": { "color": true } } } },
                "endColor": { "type": { "fill": { "solid": { "color": true } } } },
                "splitLow": { "type": { "fill": { "solid": { "color": true } } } },
                "splitMid": { "type": { "fill": { "solid": { "color": true } } } },
                "splitHigh": { "type": { "fill": { "solid": { "color": true } } } },
                "noDataColor": { "type": { "fill": { "solid": { "color": true } } } },
                "scaleMode": { "type": { "enumeration": [ { "value": "quantile", "displayName": "Quantile" }, { "value": "linear", "displayName": "Linear" }, { "value": "log", "displayName": "Log" } ] } },
                "bucketCount": { "type": { "enumeration": [ { "value": "0", "displayName": "Continuous" }, { "value": "3", "displayName": "3" }, { "value": "5", "displayName": "5" }, { "value": "7", "displayName": "7" } ] } }
            }
        },
        "legend": {
            "properties": {
                "show": { "type": { "bool": true } },
                "position": { "type": { "enumeration": [ { "value": "bottom", "displayName": "Bottom" }, { "value": "top", "displayName": "Top" } ] } },
                "align": { "type": { "enumeration": [ { "value": "start", "displayName": "Left" }, { "value": "center", "displayName": "Center" }, { "value": "end", "displayName": "Right" } ] } },
                "swatchSize": { "type": { "numeric": true } },
                "gradientLength": { "type": { "numeric": true } },
                "showLabels": { "type": { "bool": true } },
                "lessLabel": { "type": { "text": true } },
                "moreLabel": { "type": { "text": true } },
                "showNoData": { "type": { "bool": true } },
                "noDataSide": { "type": { "enumeration": [ { "value": "right", "displayName": "Right" }, { "value": "left", "displayName": "Left" } ] } },
                "title": { "type": { "text": true } }
            }
        },
        "insights": {
            "properties": {
                "show": { "type": { "bool": true } },
                "polarity": { "type": { "enumeration": [ { "value": "good", "displayName": "Good (more is better)" }, { "value": "bad", "displayName": "Bad (less is better)" }, { "value": "neutral", "displayName": "Neutral" } ] } },
                "count": { "type": { "numeric": true } }
            }
        },
        "accessibility": {
            "properties": {
                "focusRing": { "type": { "bool": true } },
                "patternOnThreshold": { "type": { "bool": true } },
                "patternThresholdValue": { "type": { "numeric": true } }
            }
        },
        "header": {
            "properties": {
                "titleText": { "type": { "text": true } },
                "align": { "type": { "enumeration": [ { "value": "left", "displayName": "Left" }, { "value": "center", "displayName": "Center" }, { "value": "right", "displayName": "Right" } ] } },
                "ruleShow": { "type": { "bool": true } },
                "ruleColor": { "type": { "fill": { "solid": { "color": true } } } },
                "ruleWidth": { "type": { "numeric": true } }
            }
        },
        "badges": {
            "properties": {
                "peakOn": { "type": { "bool": true } },
                "peakEmoji": { "type": { "text": true } },
                "thresholdOn": { "type": { "bool": true } },
                "thresholdValue": { "type": { "numeric": true } },
                "thresholdEmoji": { "type": { "text": true } }
            }
        },
        "toolbar": {
            "properties": {
                "show": { "type": { "bool": true } },
                "position": { "type": { "enumeration": [ { "value": "auto", "displayName": "Auto (avoid content)" }, { "value": "bl", "displayName": "Bottom left" }, { "value": "tl", "displayName": "Top left" }, { "value": "tr", "displayName": "Top right" }, { "value": "br", "displayName": "Bottom right" } ] } },
                "closeOnClickAway": { "type": { "bool": true } }
            }
        },
        "headline": { "properties": { "fontFamily": { "type": { "text": true } }, "fontSize": { "type": { "numeric": true } }, "bold": { "type": { "bool": true } }, "italic": { "type": { "bool": true } }, "underline": { "type": { "bool": true } }, "color": { "type": { "fill": { "solid": { "color": true } } } } } },
        "statChips": { "properties": { "fontFamily": { "type": { "text": true } }, "fontSize": { "type": { "numeric": true } }, "bold": { "type": { "bool": true } }, "italic": { "type": { "bool": true } }, "underline": { "type": { "bool": true } }, "color": { "type": { "fill": { "solid": { "color": true } } } } } },
        "monthRail": { "properties": { "fontFamily": { "type": { "text": true } }, "fontSize": { "type": { "numeric": true } }, "bold": { "type": { "bool": true } }, "italic": { "type": { "bool": true } }, "underline": { "type": { "bool": true } }, "color": { "type": { "fill": { "solid": { "color": true } } } } } },
        "weekdayRail": { "properties": { "fontFamily": { "type": { "text": true } }, "fontSize": { "type": { "numeric": true } }, "bold": { "type": { "bool": true } }, "italic": { "type": { "bool": true } }, "underline": { "type": { "bool": true } }, "color": { "type": { "fill": { "solid": { "color": true } } } } } },
        "yearTags": { "properties": { "fontFamily": { "type": { "text": true } }, "fontSize": { "type": { "numeric": true } }, "bold": { "type": { "bool": true } }, "italic": { "type": { "bool": true } }, "underline": { "type": { "bool": true } }, "color": { "type": { "fill": { "solid": { "color": true } } } } } },
        "legendText": { "properties": { "fontFamily": { "type": { "text": true } }, "fontSize": { "type": { "numeric": true } }, "bold": { "type": { "bool": true } }, "italic": { "type": { "bool": true } }, "underline": { "type": { "bool": true } }, "color": { "type": { "fill": { "solid": { "color": true } } } } } },
        "facetTitle": { "properties": { "fontFamily": { "type": { "text": true } }, "fontSize": { "type": { "numeric": true } }, "bold": { "type": { "bool": true } }, "italic": { "type": { "bool": true } }, "underline": { "type": { "bool": true } }, "color": { "type": { "fill": { "solid": { "color": true } } } } } },
        "branding": { "properties": { "showBranding": { "type": { "bool": true } } } }
    },
    "supportsHighlight": true,
    "supportsKeyboardFocus": true,
    "tooltips": {
        "supportedTypes": { "default": false, "canvas": false },
        "roles": ["tooltips"]
    },
    "privileges": []
}
